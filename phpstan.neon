includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:
    paths:
        - src
        - tests
    level: 5
    excludePaths:
        - vendor
    bootstrapFiles:
        - phpstan-bootstrap.php
    ignoreErrors:
        # Pest resolves `it()`, `beforeEach()` and `expect()` through `__call`,
        # and exposes test-local state as dynamic properties. Both are
        # load-bearing features of the framework, not defects.
        - '#Call to an undefined method Pest\\PendingCalls\\TestCall::#'
        - '#Access to an undefined property Pest\\PendingCalls\\TestCall::#'
        # Pest's fluent API mutates the expectation in place, so `->not` and
        # friends are dynamic properties on a generic `Expectation<T>`.
        - '#Access to an undefined property Pest\\Mixins\\Expectation<#'
        # `SkillSummary`/`SkillDescriptor` gained `requiredTools` in an
        # unreleased core, and the dev pin is 0.29.0, so PHPStan reads a
        # constructor that has no such parameter. The call site is guarded by
        # `class_exists(Spora\Skills\AllowedTools::class)` and the argument is
        # spread, so the argument is simply absent on this core. `reportUnmatched`
        # because the entry becomes dead the day the pin moves past the release
        # and PHPStan treats a never-matching pattern as an error on its own.
        -
            message: '#^Unknown parameter \$requiredTools in call to Spora\\Skills\\Skill(Descriptor|Summary) constructor\.$#'
            reportUnmatched: false
